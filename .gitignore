# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---- ML / data artifacts ----
# Raw dataset is too large to version
data/raw/*
!data/raw/.gitkeep

# Model checkpoints
*.pth
*.pt
*.ckpt
*.onnx

# Experiment outputs (keep folder + metadata only)
experiments/*
!experiments/.gitkeep
!experiments/**/config.yaml
!experiments/**/metrics.json

# Experiment trackers
wandb/
runs/
lightning_logs/
mlruns/
*.tfevents.*

# Optuna studies
*.db

# ---- Splits ----
# Persisted splits ARE versioned (small, reproducibility-critical) -> NOT ignored.
# (data/splits/*.csv and *.parquet are intentionally tracked.)

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Secrets ----
kaggle.json
.env
